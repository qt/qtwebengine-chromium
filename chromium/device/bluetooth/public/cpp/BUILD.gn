import("//device/device.gni")

source_set("cpp") {
  sources = [
    "bluetooth_address.cc",
    "bluetooth_address.h",
    "bluetooth_uuid.cc",
    "bluetooth_uuid.h",
  ]
  deps = [ "//base" ]
  public_deps = [ ":features" ]

  configs -= device_remove_configs
  configs += device_add_configs
}

component("features") {
  public = [ "bluetooth_features.h" ]
  sources = [
    "bluetooth_features.cc",
    "bluetooth_features_export.h",
  ]
  deps = [ "//base" ]
  defines = [ "BLUETOOTH_FEATURES_IMPLEMENTATION" ]

  configs -= device_remove_configs
  configs += device_add_configs
}
