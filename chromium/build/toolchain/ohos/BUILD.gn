import("//build/config/ohos/config.gni")
import("//build/toolchain/gcc_toolchain.gni")

declare_args() {
  # Whether unstripped binaries (compiled with debug symbols) should be
  # considered runtime_deps rather than stripped ones.
  ohos_unstripped_runtime_outputs = true
}

# The OHOS clang toolchains share most parameters, so this wraps gcc_toolchain
# to avoid duplication.
template("ohos_clang_toolchain") {
  gcc_toolchain(target_name) {
    assert(defined(invoker.toolchain_args),
           "toolchain_args must be defined for ohos_clang_toolchain()")

    toolchain_args = {
      forward_variables_from(invoker.toolchain_args, "*")
      current_os = "ohos"
    }

    # Output linker map files for binary-size analysis.
    enable_linker_map = true

    _prefix = rebase_path("$ohos_toolchain_root/bin", root_build_dir)
    cc = "$_prefix/clang"
    cxx = "$_prefix/clang++"
    ar = "$_prefix/llvm-ar"
    ld = cxx
    readelf = "$_prefix/llvm-readobj"
    nm = "$_prefix/llvm-nm"
    strip = rebase_path("$ohos_toolchain_root/bin/llvm-strip", root_build_dir)
    use_unstripped_as_runtime_outputs = ohos_unstripped_runtime_outputs

    # loadable_modules are always loaded via absolute path; keep plain ".so".
    loadable_module_extension = ".so"
  }
}

ohos_clang_toolchain("ohos_clang_arm64") {
  toolchain_args = {
    current_cpu = "arm64"
  }
}
